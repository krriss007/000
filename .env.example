# Copy to .env (or export) — never commit real secrets.

# REQUIRED in production: 32-byte hex key for the credential vault.
#   openssl rand -hex 32
ARBSCOPE_MASTER_KEY=

# Market data mode: simulated | live | auto
DATA_MODE=auto
NODE_ENV=development

# HTTP bind
PORT=8787
HOST=0.0.0.0

# Where state.json (settings, encrypted credentials, orders, audit log) is stored
DATA_DIR=./data

# Market-data behavior
POLL_INTERVAL_MS=3000
STALE_AFTER_MS=10000
FETCH_TIMEOUT_MS=6000
