# ---------------------------------------------------------------------------
# Aether Catalog configuration (copy to .env — never commit .env)
# ---------------------------------------------------------------------------

# Backend to read. Defaults to the public Aether backend when unset.
AETHER_BACKEND_URL=https://backend.aether.cx

# HTTP port / bind address for this app.
PORT=3000
HOST=0.0.0.0

# ---------------------------------------------------------------------------
# Account (optional). The mnemonic is the Aether account: 12–24 words, no
# password, no email. Set it and the server signs in at boot; leave it out and
# sign in through the UI instead (the mnemonic is then kept in server memory).
#
# Either way it stays on the server: it is never sent to the browser, never
# written to disk and never logged. Only the resulting session token is cached
# in data/session.json (git-ignored, mode 600) so restarts stay signed in.
# ---------------------------------------------------------------------------
# AETHER_MNEMONIC="word word word word word word word word word word word word"

# Alternatively reuse an existing session token (it must belong to the account
# you want to read). Takes precedence over the cached token.
# AETHER_SESSION_TOKEN=

# Device label recorded on the session the backend creates.
AETHER_DEVICE_NAME=Aether Catalog

# Namespace used only when creating a brand-new account via the UI.
AETHER_NAMESPACE=aether.cx

# Only needed if the backend ever enables a captcha (currently hasCaptcha=false).
# AETHER_CAPTCHA_TOKEN=

# ---------------------------------------------------------------------------
# Networking / politeness towards the shared backend
# ---------------------------------------------------------------------------
AETHER_TIMEOUT_MS=20000
AETHER_PROBE_TIMEOUT_MS=7000
AETHER_MAX_RETRIES=2
AETHER_MIN_INTERVAL_MS=250
AETHER_MAX_CONCURRENT=4
AETHER_MAX_BYTES=12582912

# Trending windows pulled from /metrics/* — "monthly" is the largest payload,
# so it is opt-in by default.
AETHER_METRICS_WINDOWS=daily,weekly

# This app's own per-client limit (requests/minute).
APP_RATE_LIMIT=180

LOG_LEVEL=info

# Dev/test only: pretend the server cannot reach the backend so the browser
# fallback path can be exercised.
# AETHER_FORCE_DIRECT=0
